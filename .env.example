# ================================================
# XOXO Chat — Environment Configuration
# Copy this file to .env and fill in your values.
# ================================================

# ----- App Identity -----
APP_NAME="XOXO Chat"
APP_TAGLINE="Chat with Stranger Anonymously"
APP_URL=https://chat.1year.site
APP_ENV=production

# ----- WebSocket Server -----
WS_PORT=8080
WS_PUBLIC_URL=wss://chat.1year.site/ws
WS_ALLOWED_ORIGINS=chat.1year.site,localhost,127.0.0.1

# ----- Redis -----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ----- Bot Prevention & Safety -----
IP_CONNECTION_LIMIT=5
ANTI_SPAM_COOLDOWN=0.5
SPAM_WARN_THRESHOLD=3

# ----- Group Room Settings -----
GROUP_INACTIVITY_TIMEOUT=300
